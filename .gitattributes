# GitHub language stats: count the code, not data, results, docs or generated pages.
# linguist-detectable=false is what actually removes a file from the language bar.
data/** linguist-generated=true linguist-detectable=false
results/** linguist-generated=true linguist-detectable=false
docs/** linguist-documentation=true linguist-detectable=false
research_notes/** linguist-documentation=true linguist-detectable=false
